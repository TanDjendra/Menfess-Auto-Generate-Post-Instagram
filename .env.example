# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=3000

# Public URL of THIS service (Render/Railway/ngrok/etc).
# When set, Instagram pulls the card straight from /media/... instead of a
# throwaway file host. Highly recommended in production.
PUBLIC_BASE_URL=

# ------------------------------------------------------------------
# Firebase Realtime Database
# ------------------------------------------------------------------
# Either a path to the service-account JSON file, or the JSON itself in one line.
FIREBASE_CREDENTIALS=./firebase-key.json
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

# Database path that holds the queue (handy for staging: /menfess_queue_test)
QUEUE_PATH=/menfess_queue

# ------------------------------------------------------------------
# Gemini (caption writer). Falls back to offline captions when empty.
# ------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ------------------------------------------------------------------
# Instagram Graph API
# ------------------------------------------------------------------
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v20.0
# Shown on the card footer
IG_HANDLE=@akunmenfesskamu

# Render everything but never publish to Instagram (great for testing)
DRY_RUN=false

# ------------------------------------------------------------------
# Card look & feel
# ------------------------------------------------------------------
BRAND_TITLE=Menfess
BRAND_TAGLINE=kirim rahasiamu, tetap anonim
# Force one palette instead of auto-picking by mood:
# strawberry-milk | mint-soda | lavender-dream | peach-sunset
# blueberry-sky | matcha-latte | bubblegum-pop | cream-honey
CARD_THEME=
CARD_SIZE=1080
# Default header adalah ikon surat. Set true kalau mau maskot hewan besar
# (beruang/kucing/kelinci/panda/kodok/anak ayam) nongol di atas kartu.
CARD_MASCOT=false

# Animated GIF (used for Stories / the web gallery, not for the IG feed post)
GIF_ENABLED=true
GIF_SIZE=480
GIF_FRAMES=20
GIF_DELAY=80
GIF_COLORS=200

# ------------------------------------------------------------------
# Limits & retries
# ------------------------------------------------------------------
MAX_TEXT_LENGTH=300
SUBMIT_COOLDOWN_MS=60000
PREVIEW_COOLDOWN_MS=2500
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=15000
# Minimum gap between two Instagram posts (0 = no throttle)
POST_INTERVAL_MS=0
